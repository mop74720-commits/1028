+\begin{equation}
+ \ell(s)^{\mathsf T}=N_w(s)\Phi_nD_s,\qquad
+ d=D_s\Phi_n^{\mathsf T}e_\vartheta.
+ \label{mech:shape-maps}
+\end{equation}
