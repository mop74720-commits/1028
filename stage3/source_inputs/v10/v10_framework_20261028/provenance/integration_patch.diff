-\begin{align}
- \widehat R_N(\vartheta)
- &=\frac1N\sum_{i=1}^N
-    \|\nabla H_\vartheta(X_i)-\nabla H_\star(X_i)\|_p^p,\\
- L_{\mathrm{par}}&=pQ^{p-1}L_g,\qquad L_{\max}=Q^p.
