+       &\ \tfrac12(\widetilde u-u_{\rm req})^{\mathsf T}
+                 R_u(\widetilde u-u_{\rm req}),\nonumber\\
+ \text{subject to }&\quad
+ a_P^{\mathsf T}\widetilde u\le\kappa(E_{\max}-W),
+ \qquad \kappa>0.
+ \label{app:work-governor}
+\end{align}
