-\begin{align}
- \|\nabla H_\vartheta(x)-\nabla H_\star(x)\|_p&\leq Q,\label{eq:residual-bound}\\
- \|\nabla H_\vartheta(x)-\nabla H_\eta(x)\|_p
-   &\leq L_g\|\vartheta-\eta\|_\infty.\label{eq:parameter-bound}
-\end{align}
