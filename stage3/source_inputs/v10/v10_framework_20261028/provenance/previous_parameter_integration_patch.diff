+\begin{align}
+ H_0(q,p)&=\tfrac12p^{\mathsf T}M_f^{-1}p
+             +\tfrac12q^{\mathsf T}K_{\rm beam}q\nonumber\\
+ &\quad+E_0[1-\cos\vartheta].
+ \label{mech:fe-energy}
+\end{align}
